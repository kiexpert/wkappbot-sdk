<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>wkappbot</AssemblyName>
    <RootNamespace>WKAppBot.Launcher</RootNamespace>
    <Version>$(WKAppBotVersion)</Version>
    <!-- AOT: native code only, no .NET runtime startup overhead → ~50ms cold start -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <!-- UTF-8 active code page via manifest: OS sets CP65001 at process load, no runtime API call needed -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\AppBotPipe.cs" Link="Shared\AppBotPipe.cs" />
    <Compile Include="..\Shared\AppBotPipe.Admin.cs" Link="Shared\AppBotPipe.Admin.cs" />
    <Compile Include="..\Shared\AppBotPipe.HotSwap.cs" Link="Shared\AppBotPipe.HotSwap.cs" />
    <Compile Include="..\Shared\ProjectRoot.cs" Link="Shared\ProjectRoot.cs" />
    <Compile Include="..\Shared\NonBlockingLineReader.cs" Link="Shared\NonBlockingLineReader.cs" />
    <Compile Include="..\Shared\InterruptChannel.cs" Link="Shared\InterruptChannel.cs" />
  </ItemGroup>

  <!-- Repo-relative bin dir: <repo>/bin (resolved from csproj: csharp/src/WKAppBot.Launcher/) -->
  <PropertyGroup>
    <RepoBin Condition="'$(RepoBin)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\..\bin'))</RepoBin>
  </PropertyGroup>

  <!-- PublishAot native linker invokes vswhere.exe to locate Visual Studio Build Tools. -->
  <!-- vswhere.exe lives at "C:\Program Files (x86)\Microsoft Visual Studio\Installer"     -->
  <!-- but that directory isn't on PATH by default in shells outside Developer PowerShell. -->
  <!-- Without this fix, `dotnet publish` from plain bash/cmd fails with                   -->
  <!--   MSB3073: 'vswhere.exe' is not recognized ... command exited with code 123.        -->
  <!-- Fix: prepend the VS Installer dir to the MSBuild process's PATH before IlcCompile   -->
  <!-- runs. Child <Exec> tasks (including the native linker) inherit this PATH.           -->
  <UsingTask TaskName="PrependVsInstallerPath"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
        string[] candidates = {
          @"C:\Program Files (x86)\Microsoft Visual Studio\Installer",
          @"C:\Program Files\Microsoft Visual Studio\Installer"
        };
        foreach (var dir in candidates) {
          var exe = Path.Combine(dir, "vswhere.exe");
          if (!File.Exists(exe)) continue;
          var path = Environment.GetEnvironmentVariable("PATH") ?? "";
          var sep = path.Length > 0 && !path.EndsWith(";") ? ";" : "";
          if (path.IndexOf(dir, StringComparison.OrdinalIgnoreCase) < 0) {
            Environment.SetEnvironmentVariable("PATH", dir + ";" + path);
            Log.LogMessage(MessageImportance.High, "[AOT] prepended to PATH for vswhere: " + dir);
          }
          break;
        }
        ]]>
      </Code>
    </Task>
  </UsingTask>
  <Target Name="EnsureVsWhereOnPath" BeforeTargets="CollectFrameworkReferences;PrepareForBuild;CoreCompile;IlcCompile" Condition="'$(OS)' == 'Windows_NT' and '$(PublishAot)' == 'true'">
    <PrependVsInstallerPath />
  </Target>

  <!-- Post-publish: rename-old + copy-new launcher deploy -->
  <!-- NTFS allows renaming a running exe; overwrite while locked fails.          -->
  <!-- Strategy: rename current → .old-{ts}.exe, then copy new → wkappbot.exe.   -->
  <!-- Also deploys to sibling repos that put wkappbot.exe on PATH (WKAppBot/bin) -->
  <UsingTask TaskName="DeployLauncherTask"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <PublishExe ParameterType="System.String" Required="true" />
      <DeployDirs ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
        var ts = DateTime.Now.ToString("yyyyMMdd-HHmm");
        foreach (var dir in DeployDirs.Split(';'))
        {
          if (string.IsNullOrWhiteSpace(dir)) continue;
          Directory.CreateDirectory(dir);
          var dest = Path.Combine(dir, "wkappbot.exe");
          var old  = Path.Combine(dir, $"wkappbot.old-{ts}.exe");
          try
          {
            if (File.Exists(dest))
            {
              if (File.Exists(old)) File.Delete(old);
              File.Move(dest, old);
              Log.LogMessage(MessageImportance.High, $"[Launcher] renamed: wkappbot.exe -> wkappbot.old-{ts}.exe in {dir}");
            }
            File.Copy(PublishExe, dest, overwrite: false);
            // Update busybox symlink aliases
            foreach (var alias in new[] { "a11y", "wka11y", "wkedit", "grap", "grep" })
            {
              var aliasExe = Path.Combine(dir, alias + ".exe");
              if (File.Exists(aliasExe)) { try { File.Copy(dest, aliasExe, overwrite: true); } catch { } }
            }
            Log.LogMessage(MessageImportance.High, $"[Launcher] deployed: wkappbot.exe -> {dir}");
          }
          catch (Exception ex)
          {
            Log.LogWarning($"[Launcher] deploy failed for {dir}: {ex.Message}");
          }
        }
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="DeployLauncher" AfterTargets="CopyNativeBinary" Condition="'$(SkipDeployLauncher)' != 'true'">
    <PropertyGroup>
      <!-- Extra deploy targets: sibling repos under the same parent folder that have a bin/ with wkappbot.exe -->
      <SiblingWKAppBotBin>$([System.IO.Path]::GetFullPath('$(RepoBin)\..\..\WKAppBot\bin'))</SiblingWKAppBotBin>
      <ExtraDeployDirs Condition="Exists('$(SiblingWKAppBotBin)\wkappbot.exe')">$(SiblingWKAppBotBin)</ExtraDeployDirs>
      <AllDeployDirs>$(RepoBin);$(ExtraDeployDirs)</AllDeployDirs>
    </PropertyGroup>
    <DeployLauncherTask PublishExe="$(PublishDir)wkappbot.exe" DeployDirs="$(AllDeployDirs)" />
  </Target>

</Project>
