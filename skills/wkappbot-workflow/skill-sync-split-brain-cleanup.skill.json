  "requirements": [
    {
      "cmd": "wkappbot skill sync",
      "expect": "[SKILL:SYNC] done -- installed=.*CONFLICTS=.*|[SKILL:SYNC] done -- installed=.* up-to-date=.*",
      "prompt": null
